{
  "manifest_version": 3,
  "name": "ChatGPT: The Wolf Expansion",
  "version": "0.2.2.2",
  "description": "Local-first Quick Access and folder organization for ChatGPT.",
  "icons": {
    "16": "icons/wolf-expansion-mark-16.png",
    "32": "icons/wolf-expansion-mark-32.png",
    "48": "icons/wolf-expansion-mark-48.png",
    "96": "icons/wolf-expansion-mark-96.png",
    "128": "icons/wolf-expansion-mark-128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://chatgpt.com/*"],
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/settings-gear.svg",
        "icons/wolf-expansion-mark-32.png"
      ],
      "matches": ["https://chatgpt.com/*"]
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "chatgpt-the-wolf-expansion@wolfy",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
